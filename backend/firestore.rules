rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 'Customer';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'Admin';
    }

    function isLoanOfficer() {
      return isAuthenticated() && (getUserRole() == 'Loan Officer' || getUserRole() == 'Admin');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isAdmin();

      match /documents/{docId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isLoanOfficer());
      }
    }

    match /loans/{loanId} {
      allow read: if isAuthenticated() && (resource.data.borrowerId == request.auth.uid || isLoanOfficer());
      allow create: if isAuthenticated() && request.resource.data.borrowerId == request.auth.uid;
      allow update: if isLoanOfficer() || (isAuthenticated() && resource.data.borrowerId == request.auth.uid && resource.data.status == 'Pending');
      allow delete: if isAdmin();
    }

    match /installments/{installmentId} {
      allow read: if isAuthenticated();
      allow write: if isLoanOfficer();
    }

    match /transactions/{txnId} {
      allow read: if isAuthenticated() && (resource.data.borrowerId == request.auth.uid || isLoanOfficer());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isLoanOfficer();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
