// use prisma-8
enum TransactionType {
  Offer
  Payback
}

enum Role {
  Customer
  Officer
  Admin
}

enum State{
  Active
  Blacklisted
}

model User {
  id        String     @id @default(uuid())
  email     String   @unique
  username  String?
  name      String
  loans     Loan[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  role     Role     @default(Customer)
  state   State    @default(Active)

}

model Loan {
  id        String      @id @default(uuid())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  transactions Transaction[]
  amount    Float
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
model Transaction{
  id       String      @id @default(uuid())
  amount    Float
  loan      Loan     @relation(fields: [loanId], references: [id])
  loanId    Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  TransactionType TransactionType @default(Offer)
}

